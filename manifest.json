{
  "manifest_version": 2,
  "name": "Financial Statement Downloader",
  "version": "1.3.0",
  "description": "Bulk-downloads statements and related financial documents from supported institutions.",
  "background": {
    "scripts": [
      "core/runtime.js",
      "providers/amazon.js",
      "core/import-client.js",
      "core/import-store.js",
      "core/import-background.js",
      "background.js"
    ],
    "persistent": true
  },
  "permissions": [
    "https://accounts.coinbase.com/*",
    "https://gdax-reports.s3.amazonaws.com/*",
    "https://digitalservices.fidelity.com/*",
    "https://dpservice.fidelity.com/*",
    "https://workplaceservices.fidelity.com/*",
    "https://www.wealthfront.com/*",
    "https://connect.meritain.com/*",
    "https://ext-web.etrade.com/*",
    "webRequest",
    "downloads",
    "storage",
    "https://www.amazon.com/*",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://accounts.coinbase.com/statements/pro*",
        "https://digitalservices.fidelity.com/navigate/ent-documentcenter/*",
        "https://www.wealthfront.com/documents*",
        "https://connect.meritain.com/Member/MemberClaim/ClaimSummary*",
        "https://us.etrade.com/etx/pxy/accountdocs*",
        "https://workplaceservices.fidelity.com/mybenefits/savings2/*",
        "https://www.amazon.com/gp/css/order-history*",
        "https://www.amazon.com/your-orders/*",
        "https://www.amazon.com/fopo/order-details*",
        "https://www.amazon.com/uff/your-account/order-details*"
      ],
      "js": [
        "core/runtime.js",
        "core/storage.js",
        "core/batch.js",
        "core/ui.js",
        "providers/coinbase.js",
        "providers/fidelity.js",
        "providers/wealthfront.js",
        "providers/netbenefits.js",
        "providers/meritain.js",
        "providers/etrade.js",
        "providers/amazon.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-statement-downloader-extension@bwh.local",
      "strict_min_version": "78.0"
    }
  },
  "optional_permissions": [
    "https://pfifi.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
